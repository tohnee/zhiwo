{
  "name": "knowledgeos-mvp",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "node apps/api-gateway/src/server.js",
    "dev:web": "pnpm --filter web dev --host 0.0.0.0",
